# Public URL of Go API (browser-accessible).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical site origin for metadataBase / Open Graph absolute URLs.
# Defaults to https://dadiary.vn when unset. NEXT_PUBLIC_SITE_URL is also accepted.
# NEXT_PUBLIC_APP_URL=https://dadiary.vn

# --- Search Console / Bing (HTML tag verification) ---
# 1) Google Search Console → Add property https://dadiary.vn → HTML tag → paste content= value
# 2) Bing Webmaster → Add site → HTML meta tag → paste content= value (msvalidate.01)
# 3) Deploy, then click Verify. Submit sitemap: https://dadiary.vn/sitemap.xml
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional X/Twitter @handle for twitter:site (include leading @)
# NEXT_PUBLIC_TWITTER_SITE=@dadiary

# Self-serve SePay checkout on /pricing (Upgrade). Default OFF for Beta.
# Set true only when live payments (or local SePay smoke) should be open.
# NEXT_PUBLIC_SEPAY_CHECKOUT_ENABLED=true

# Web Push VAPID public key (Phase 1 subscribe). Generate a pair with web-push
# (npm i -g web-push && web-push generate-vapid-keys). Private key stays server-side in Phase 2.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile (optional local; set with DADIARY_TURNSTILE_SECRET_KEY on API).
# https://dash.cloudflare.com/ → Turnstile → create widget → Site Key (public) + Secret Key (server).
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Meta (Facebook) Pixel ID — Events Manager → Data sources → Pixel.
# Defaults to production Pixel if unset (see components/site/meta-pixel.tsx).
# NEXT_PUBLIC_META_PIXEL_ID=1673924784100065
