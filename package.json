{
  "name": "dadiary-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:i18n && next build",
    "start": "next start",
    "lint": "eslint",
    "test:i18n": "npx --yes tsx --test lib/i18n/client-messages.test.ts",
    "test:unit": "npx --yes tsx --test lib/i18n/client-messages.test.ts lib/auth/return-path.test.ts lib/onboarding/post-auth-destination.test.ts lib/onboarding/claim-guest-coach-welcome.test.ts lib/onboarding/coach-notes-sections.test.ts",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "og:default": "node scripts/generate-og-default.mjs",
    "print:share-clipboard": "npx --yes tsx scripts/print-skin-review-share-clipboard.ts",
    "sync:affiliate-catalog": "node scripts/sync-affiliate-catalog.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@marsidev/react-turnstile": "^1.5.2",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.100.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.14.0",
    "next": "^15.5.15",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
