# Copy to .env.e2e and adjust. Used by `npm run test:e2e` (Playwright).

# Frontend origin (Next.js)
E2E_WEB_URL=http://localhost:3000

# Backend API (must match NEXT_PUBLIC_API_URL used by the FE process)
E2E_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Required for SePay upgrade smoke (API must also set DADIARY_SEPAY_CHECKOUT_ENABLED=true)
NEXT_PUBLIC_SEPAY_CHECKOUT_ENABLED=true

# SePay IPN secret — must match backend DADIARY_SEPAY_SECRET_KEY
E2E_SEPAY_SECRET_KEY=spsk_test_etsH4PdQCBM7KvtTCjkJ5GpLjqYwMX89

# Enables E2E helpers on the API (MUST match DADIARY_E2E_SECRET):
#   POST /api/v1/internal/e2e/force-plan
#   GET  /api/v1/internal/e2e/alerts          ← Telegram/payment_success capture
#   DELETE /api/v1/internal/e2e/alerts
#   GET  /api/v1/internal/e2e/ops-events
E2E_SECRET=local-e2e-secret

# Optional password for generated smoke users
# E2E_USER_PASSWORD=SmokeTest1!

# Onboarding smoke (onboarding-smoke.test.ts)
# - Incomplete user: API register only → login lands on /onboarding
# - Complete user: register + POST /api/v1/profile/onboarding/complete (helper)
# - No extra secrets beyond E2E_API_URL / E2E_WEB_URL
# Run: npm run test:e2e -- onboarding-smoke
